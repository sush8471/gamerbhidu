# Gamer Bhidu Environment Variables

# No external dependencies required!
# All game data is stored locally in src/data/games.ts

# Production domain for OG/Twitter meta tags (absolute URLs required)
# Set this to your deployed URL, e.g. https://gamerbhidu.vercel.app
# NEXT_PUBLIC_SITE_URL=https://gamerbhidu.vercel.app

# Optional: Add future API keys here if needed
# NEXT_PUBLIC_API_KEY=your-api-key-here
